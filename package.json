{
  "name": "quote-document-totals",
  "private": true,
  "version": "1.0.0",
  "description": "Checked document tables for Salesforce CPQ Quotes",
  "scripts": {
    "lint": "eslint \"force-app/main/default/{aura,lwc}/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "node scripts/ci/run-lwc-tests.js",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\" \".github/**/*.{md,yaml,yml}\" \"docs/**/*.md\" \"bugs/**/*.md\" \"enhancements/**/*.md\" \"scripts/ci/*.js\" \"*.{json,yaml,yml}\"",
    "prettier:verify:all": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "test:ci-gate": "node --test scripts/ci/check-contributor-versions.test.js",
    "test:docs": "node scripts/ci/check-public-docs.js && node scripts/ci/check-use-case-runbooks.js && node scripts/ci/check-documentation-facts.js",
    "ci:contributor-versions": "node scripts/ci/check-contributor-versions.js",
    "ci:use-case-runbooks": "node scripts/ci/check-use-case-runbooks.js"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
