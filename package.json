{
  "name": "quote-document-totals",
  "private": true,
  "version": "1.0.0",
  "description": "Checked document tables for Salesforce CPQ Quotes",
  "scripts": {
    "lint": "eslint \"force-app/main/default/{aura,lwc}/**/*.js\" --no-error-on-unmatched-pattern",
    "audit:dependencies": "npm audit --audit-level=high",
    "test": "npm run test:unit && npm run test:tools",
    "test:unit": "node scripts/ci/run-lwc-tests.js",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "test:tools": "node --test scripts/qdtd/*.test.js",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\" \"SUPPORT.md\" \".github/**/*.{md,yaml,yml}\" \"docs/**/*.md\" \"scripts/ci/*.js\" \"scripts/qdtd/*.js\" \"*.{json,yaml,yml}\"",
    "prettier:verify:all": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "test:ci-gate": "node --test scripts/ci/build-source-release.test.js scripts/ci/check-contributor-versions.test.js scripts/ci/check-permission-boundaries.test.js scripts/ci/check-publication-hygiene.test.js scripts/ci/check-release-manifest.test.js scripts/ci/validate-salesforce.test.js && node scripts/ci/check-permission-boundaries.js && node scripts/ci/check-publication-hygiene.js && node scripts/ci/check-release-manifest.js",
    "test:docs": "node scripts/ci/check-public-docs.js && node scripts/ci/check-use-case-runbooks.js && node scripts/ci/check-documentation-facts.js",
    "ci:contributor-versions": "node scripts/ci/check-contributor-versions.js",
    "ci:release-manifest": "node scripts/ci/check-release-manifest.js",
    "ci:use-case-runbooks": "node scripts/ci/check-use-case-runbooks.js",
    "validate:salesforce": "node scripts/ci/validate-salesforce.js",
    "inventory:retention": "node scripts/qdtd/retention-inventory.js",
    "prepare:capacity-fixtures": "node scripts/qdtd/capacity-fixtures.js",
    "benchmark:capacity": "node scripts/qdtd/capacity-benchmark.js",
    "export:live-document": "node scripts/qdtd/export-live-document.js",
    "preflight:install": "node scripts/qdtd/install-preflight.js",
    "snapshot:subscriber-config": "node scripts/qdtd/subscriber-config-snapshot.js capture",
    "compare:subscriber-config": "node scripts/qdtd/subscriber-config-snapshot.js compare",
    "build:source-release": "node scripts/ci/build-source-release.js",
    "test:renderer-contract": "node scripts/qdtd/renderer-contract.js",
    "render:reference-document": "node scripts/qdtd/render-reference-document.js"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
