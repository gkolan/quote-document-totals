q1Lines.add(newLine(q1.Id, 'QDTD-IMP-1', 10, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-IMP-6', 11, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-IMP-9', 12, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-SUP-1', 13, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-SUP-6', 14, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-SUP-9', 15, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-TRN-1', 16, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-TRN-6', 17, 2, 1000, 10.0, 'One-Time', null, false));
q1Lines.add(newLine(q1.Id, 'QDTD-TRN-9', 18, 2, 1000, 10.0, 'One-Time', null, false));
insert q1Lines;

