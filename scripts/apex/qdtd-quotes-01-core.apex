// Quote 3 - one parent with 25 direct options: the max-groups cases need a
// quote that genuinely produces more groups than a tight ceiling allows.

SBQQ__Quote__c q3 = newQuote(fixtureAccounts[2], 'Quote', 'QDTD-Q3');
insert q3;
SBQQ__QuoteLine__c q3Parent = newLine(q3.Id, 'QDTD-HW-1', 1, 1, 9000, 11.11, 'One-Time', null, false);
q3Parent.SBQQ__Bundle__c = true;
insert q3Parent;
List<SBQQ__QuoteLine__c> q3Options = new List<SBQQ__QuoteLine__c>();
List<String> q3Codes = new List<String>{'QDTD-HW-1', 'QDTD-HW-2', 'QDTD-HW-3', 'QDTD-HW-4', 'QDTD-HW-5', 'QDTD-SW-1', 'QDTD-SW-2', 'QDTD-SW-3', 'QDTD-SW-4', 'QDTD-SW-5', 'QDTD-SUB-1', 'QDTD-SUB-2', 'QDTD-SUB-3', 'QDTD-SUB-4', 'QDTD-SUB-5', 'QDTD-IMP-1', 'QDTD-IMP-2', 'QDTD-IMP-3', 'QDTD-IMP-4', 'QDTD-IMP-5', 'QDTD-SUP-1', 'QDTD-SUP-2', 'QDTD-SUP-3', 'QDTD-SUP-4', 'QDTD-SUP-5', 'QDTD-TRN-1', 'QDTD-TRN-2', 'QDTD-TRN-3', 'QDTD-TRN-4', 'QDTD-TRN-5'};
for (Integer i = 0; i < q3Codes.size(); i++) {
    SBQQ__QuoteLine__c opt = newLine(q3.Id, q3Codes[i], i + 2, 1, 100 + i, 10, 'One-Time', null, false);
    opt.SBQQ__RequiredBy__c = q3Parent.Id; opt.SBQQ__Bundled__c = true; opt.SBQQ__OptionLevel__c = 1;
    q3Options.add(opt);
}
