/**
 * QDTD foundation data loader - GENERATED by scripts/qdtd/build-load-apex.py
 * from the Snowfakery recipes in datasets/qdtd/. Do not hand-edit: regenerate.
 *
 * Step 02 of specs/quote-document-test-data. Loads accounts, contacts,
 * opportunities and the product catalogue. Quotes and quote lines are step 03.
 *
 * Re-runnable: deletes only records carrying the QDTD- marker, then rebuilds.
 */

// ---------------------------------------------------------------------------
// Teardown - strictly by marker. Nothing else is ever touched.
// ---------------------------------------------------------------------------
List<Account> priorAccounts = [SELECT Id FROM Account WHERE Name LIKE 'QDTD-%'];
if (!priorAccounts.isEmpty()) {
    delete [SELECT Id FROM SBQQ__Quote__c WHERE SBQQ__Account__c IN :priorAccounts];
    delete [SELECT Id FROM Opportunity WHERE AccountId IN :priorAccounts];
    delete priorAccounts;
}

