<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Step 01A section 4 gate. Proves uninserted Quote_Document_Row__c records survive a Flow.Interview round trip: copies every input row through a loop (order, decimal scale, nulls, booleans and non-core fields must all be preserved), suffixes each Display_Label__c to prove in-Flow mutation reaches Apex, and appends one Flow-created row. Not a contributor - it carries no business logic and is never referenced by a table definition.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Document Flow Round Trip Probe {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Document Flow Round Trip Probe</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Copy_Rows</targetReference>
        </connector>
    </start>

    <loops>
        <name>Copy_Rows</name>
        <label>Copy Rows</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <collectionReference>rows</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Collect_Row</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Build_New_Row</targetReference>
        </noMoreValuesConnector>
    </loops>

    <assignments>
        <name>Collect_Row</name>
        <label>Collect Row</label>
        <locationX>440</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>Copy_Rows.Display_Label__c</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>:FLOW</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outRows</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Copy_Rows</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Copy_Rows</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Build_New_Row</name>
        <label>Build New Row</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>newRow.Row_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Note</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Row_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FLOW_PROBE</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Display_Label__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>tableCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Display_Order__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>9990.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Group_Level__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Amount_Net__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>12.34</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Is_Displayed__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Include_In_Subtotal__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newRow.Include_In_Grand_Total__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Append_New_Row</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Append_New_Row</name>
        <label>Append New Row</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <assignmentItems>
            <assignToReference>outRows</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newRow</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Return_Rows</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Return_Rows</name>
        <label>Return Rows</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>rows</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>outRows</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <variables>
        <name>rows</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Quote_Document_Row__c</objectType>
    </variables>
    <variables>
        <name>outRows</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Quote_Document_Row__c</objectType>
    </variables>
    <variables>
        <name>newRow</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Quote_Document_Row__c</objectType>
    </variables>
    <variables>
        <name>quoteId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>tableCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>locale</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>currencyIsoCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
