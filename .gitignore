# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.cci/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Code Analyzer scan output (timestamped, regenerated per run)
code-analyzer-results-*.json
code-analyzer-results-*.log

# Local test and review output
review-artifacts/
**/testresults/
scripts/qdtd/run-slice.generated.apex
robot/**/results/
datasets/qdtd/out-*.json

# Local planning and implementation notes (not required by a clone/install)
/specs/

# Personal editor and AI-assistant setup
/.vscode/
/.idea/
*.code-workspace
/.claude/
/.agents/
/.codex/
/CLAUDE.md
/AGENTS.md
/skills-lock.json

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
.env.*
!.env.example

# Local authentication keys
*.key
*.pem

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Shared source, tests, CI, scripts, documentation, and test-org definitions
# remain versioned so another contributor can reproduce and validate changes.
